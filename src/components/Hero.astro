---
interface Props {
  crumb: string;
  eyebrow?: string;
  h1: string;
  tagline: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  note?: string;
  image?: { src: string; alt: string; width: number; height: number };
}

const { crumb, eyebrow, h1, tagline, primary, secondary, note, image } = Astro.props;
const hasRight = Boolean(Astro.slots.right);
---

<section class="hero relative overflow-hidden text-white">
  {
    image ? (
      <>
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          class="img-tuned absolute inset-0 h-full w-full object-cover"
        />
        <div class="hero-mask absolute inset-0" aria-hidden="true"></div>
      </>
    ) : (
      <div class="hero-gradient absolute inset-0" aria-hidden="true">
        <div class="hero-grid"></div>
        <div class="hero-glow"></div>
      </div>
    )
  }
  <div class="container-shell relative">
    <div
      class={`grid min-h-[360px] items-center gap-10 py-14 md:min-h-[430px] md:py-16 ${
        hasRight ? 'md:grid-cols-12' : ''
      }`}
    >
      <div class={hasRight ? 'md:col-span-5' : 'md:col-span-12'}>
        <nav aria-label="面包屑" class="inline-flex rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-[12px] text-white/75 backdrop-blur">
          <a href="/website" class="hover:text-white">首页</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span>{crumb}</span>
        </nav>
        {eyebrow && (
          <p class="mt-6 text-[12px] font-bold uppercase tracking-[.16em] text-white/65">{eyebrow}</p>
        )}
        <h1 class="mt-4 max-w-[16ch] text-white">{h1}</h1>
        <p class="mt-6 max-w-[38rem] text-[16px] leading-[1.85] text-white/82 md:text-[17px]">{tagline}</p>
        {(primary || secondary) && (
          <p class="mt-8 flex flex-wrap gap-4">
            {primary && <a href={primary.href} class="btn-accent">{primary.label}</a>}
            {secondary && <a href={secondary.href} class="btn-ghost">{secondary.label}</a>}
          </p>
        )}
        {note && (
          <p class="mt-8 inline-block rounded-[10px] border border-white/40 px-4 py-2 text-sm text-white/85">
            {note}
          </p>
        )}
      </div>
      {hasRight && <div class="md:col-span-7"><slot name="right" /></div>}
    </div>
  </div>
</section>
