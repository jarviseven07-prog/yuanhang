---
import Icon from './Icon.astro';

export interface FeatureItem {
  name: string;
  desc?: string;
  list?: string[];
}

interface Props {
  items: FeatureItem[];
  columns?: 2 | 3 | 4;
  numbered?: boolean;
  icons?: string[];
}

const { items, columns = 3, numbered = false, icons } = Astro.props;

const colCls =
  columns === 2
    ? 'md:grid-cols-2'
    : columns === 4
      ? 'md:grid-cols-2 lg:grid-cols-4'
      : 'md:grid-cols-2 lg:grid-cols-3';
---

<ul class={`grid grid-cols-1 gap-4 md:gap-6 ${colCls}`}>
  {
    items.map((item, i) => (
      <li class="card-hover relative overflow-hidden rounded-[18px] border border-hairline bg-white p-7">
        {numbered && (
          <span
            aria-hidden="true"
            class="pointer-events-none absolute right-6 top-4 select-none text-[48px] font-bold leading-none text-hairline"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
        )}
        <div class="relative">
          {icons?.[i] && (
            <span class="flex h-12 w-12 items-center justify-center rounded-[12px] bg-tint text-brand">
              <Icon name={icons[i]} size={24} />
            </span>
          )}
          <h3 class={icons?.[i] ? 'mt-5' : 'mt-1'}>{item.name}</h3>
          {item.desc && <p class="mt-2 text-[15px] leading-[1.7] text-muted">{item.desc}</p>}
          {item.list && (
            <ul class="mt-4 space-y-2">
              {item.list.map((li) => (
                <li class="flex gap-2 text-[15px] leading-[1.6] text-muted">
                  <span aria-hidden="true" class="text-brand">·</span>
                  <span>{li}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ul>
