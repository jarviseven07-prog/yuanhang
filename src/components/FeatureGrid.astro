---
export interface FeatureItem {
  name: string;
  desc?: string;
  list?: string[];
}

interface Props {
  items: FeatureItem[];
  columns?: 2 | 3 | 4;
  numbered?: boolean;
}

const { items, columns = 3, numbered = false } = Astro.props;

const colCls =
  columns === 2
    ? 'md:grid-cols-2'
    : columns === 4
      ? 'md:grid-cols-2 lg:grid-cols-4'
      : 'md:grid-cols-2 lg:grid-cols-3';
---

<ul class={`grid grid-cols-1 gap-4 md:gap-6 ${colCls}`}>
  {
    items.map((item, i) => (
      <li class="rounded border border-slate-200 bg-white p-6">
        {numbered && (
          <p class="mb-2 text-sm font-semibold tabular-nums text-primary">
            {String(i + 1).padStart(2, '0')}
          </p>
        )}
        <h3>{item.name}</h3>
        {item.desc && <p class="mt-2 text-slate-700">{item.desc}</p>}
        {item.list && (
          <ul class="mt-4 space-y-2">
            {item.list.map((li) => (
              <li class="flex gap-2 text-sm text-slate-700">
                <span aria-hidden="true" class="text-primary">
                  ·
                </span>
                <span>{li}</span>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
