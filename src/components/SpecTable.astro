---
import SpecTableCore from './SpecTableCore.astro';

interface Props {
  columns: string[];
  rows: string[][];
  note?: string;
  wide?: boolean;
  limit?: number;
  rowHeaders?: boolean;
  checkCells?: boolean;
  leftCols?: number;
}

const {
  columns,
  rows,
  note,
  wide = false,
  limit,
  rowHeaders = true,
  checkCells = false,
  leftCols = 1,
} = Astro.props;

const limited = limit !== undefined && rows.length > limit;
const mainRows = limited ? rows.slice(0, limit) : rows;
const restRows = limited ? rows.slice(limit) : [];
const minWidth = wide ? 'min-w-[760px]' : 'min-w-[560px]';
---

<div class="table-wrap">
  <SpecTableCore
    columns={columns}
    rows={mainRows}
    minWidth={minWidth}
    rowHeaders={rowHeaders}
    checkCells={checkCells}
    leftCols={leftCols}
  />
  <p class="mt-2 text-[13px] text-muted md:hidden">← 左右滑动查看 →</p>
</div>

{
  limited && (
    <details class="mt-6">
      <summary class="inline-block rounded-[10px] px-3 py-2">
        展开完整清单（共 {rows.length} 项）
      </summary>
      <div class="table-wrap mt-4">
        <SpecTableCore
          columns={columns}
          rows={restRows}
          minWidth={minWidth}
          rowHeaders={rowHeaders}
          checkCells={checkCells}
          leftCols={leftCols}
        />
      </div>
    </details>
  )
}

{note && <p class="mt-4 text-sm text-muted">{note}</p>}
