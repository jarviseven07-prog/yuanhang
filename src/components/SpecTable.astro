---
interface Props {
  columns: string[];
  rows: string[][];
  note?: string;
  wide?: boolean;
  limit?: number;
  rowHeaders?: boolean;
  checkCells?: boolean;
}

const {
  columns,
  rows,
  note,
  wide = false,
  limit,
  rowHeaders = true,
  checkCells = false,
} = Astro.props;

const limited = limit !== undefined && rows.length > limit;
const mainRows = limited ? rows.slice(0, limit) : rows;
const restRows = limited ? rows.slice(limit) : [];
const minWidth = wide ? 'min-w-[760px]' : 'min-w-[560px]';

const cellLabel = (cell: string): string | undefined => {
  if (!checkCells) return undefined;
  if (cell === '✓') return '包含';
  if (cell === '—') return '不包含';
  return undefined;
};
---

<div class="overflow-x-auto rounded border border-slate-200">
  <table class={`w-full border-collapse text-left text-sm ${minWidth}`}>
    <thead class="bg-slate-50">
      <tr>
        {
          columns.map((col) => (
            <th
              scope="col"
              class="border-b border-slate-200 px-4 py-4 font-semibold text-slate-900"
            >
              {col}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        mainRows.map((row) => (
          <tr class="border-b border-slate-200 last:border-b-0">
            {row.map((cell, ci) =>
              ci === 0 && rowHeaders ? (
                <th scope="row" class="px-4 py-4 text-left align-top font-medium text-slate-900">
                  {cell}
                </th>
              ) : (
                <td class="px-4 py-4 align-top text-slate-700" aria-label={cellLabel(cell)}>
                  {checkCells && cell === '✓' ? (
                    <span aria-hidden="true" class="font-semibold text-primary">
                      ✓
                    </span>
                  ) : (
                    cell
                  )}
                </td>
              )
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

{
  limited && (
    <details class="mt-4">
      <summary class="rounded p-2">
        展开完整清单（共 {rows.length} 项）
      </summary>
      <div class="mt-2 overflow-x-auto rounded border border-slate-200">
        <table class={`w-full border-collapse text-left text-sm ${minWidth}`}>
          <thead class="bg-slate-50">
            <tr>
              {columns.map((col) => (
                <th
                  scope="col"
                  class="border-b border-slate-200 px-4 py-4 font-semibold text-slate-900"
                >
                  {col}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {restRows.map((row) => (
              <tr class="border-b border-slate-200 last:border-b-0">
                {row.map((cell, ci) =>
                  ci === 0 && rowHeaders ? (
                    <th scope="row" class="px-4 py-4 text-left align-top font-medium text-slate-900">
                      {cell}
                    </th>
                  ) : (
                    <td class="px-4 py-4 align-top text-slate-700" aria-label={cellLabel(cell)}>
                      {checkCells && cell === '✓' ? (
                        <span aria-hidden="true" class="font-semibold text-primary">
                          ✓
                        </span>
                      ) : (
                        cell
                      )}
                    </td>
                  )
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )
}

{note && <p class="mt-4 text-sm text-slate-500">{note}</p>}
