---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  outro?: string;
  alt?: boolean;
  tone?: 'white' | 'tint' | 'mint';
  centered?: boolean;
}

const { id, eyebrow, title, intro, outro, alt = false, tone, centered = false } = Astro.props;
const resolvedTone = tone ?? (alt ? 'tint' : 'white');
---

<section id={id} data-tone={resolvedTone} class="sec">
  <div class="mx-auto max-w-[1200px] px-4 md:px-6">
    <div class={centered ? 'text-center' : undefined}>
      {eyebrow && <p class="text-[13px] font-semibold uppercase tracking-[.12em] text-brand">{eyebrow}</p>}
      {title && <h2 class={eyebrow ? 'mt-3' : undefined}>{title}</h2>}
      {intro && <p class={`mt-4 max-w-[720px] text-muted ${centered ? 'mx-auto' : ''}`}>{intro}</p>}
    </div>
    <div class="mt-12">
      <slot />
    </div>
    {outro && <p class="mt-12 max-w-[720px] text-muted">{outro}</p>}
  </div>
</section>
