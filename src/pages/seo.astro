---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import ContactPanel from '../components/ContactPanel.astro';

const entry = await getEntry('pages', 'seo');
if (!entry || entry.data.page !== 'seo') throw new Error('缺少 seo 页面内容');
const data = entry.data;
const { hero, sellingPoints, solution, reporting, process, cta } = data;
const cases = (await getCollection('cases')).sort((a, b) => a.id.localeCompare(b.id)).slice(0, 3);
const heroIcons = ['globe', 'social', 'data', 'search'];
const solutionIcons = ['speed', 'content', 'link', 'data'];
const processIcons = ['search', 'speed', 'content', 'link', 'monitor', 'flow'];
const metrics = [['300%', '平均流量提升'], ['10 年+', 'SEO 优化经验'], ['98%', '客户满意度']];
---

<BaseLayout title={data.title} description={data.description}>
  <section class="relative overflow-hidden bg-[#0d398a] text-white">
    <div class="hero-grid"></div>
    <div class="container-shell relative grid min-h-[520px] items-center gap-10 py-14 lg:grid-cols-[.9fr_1.1fr] lg:py-20">
      <div>
        <nav aria-label="面包屑" class="text-xs text-white/58"><a href="/website" class="hover:text-white">首页</a><span class="mx-2">/</span>Google SEO</nav>
        <p class="mt-8 text-xs font-bold uppercase tracking-[.2em] text-[#8fe0e2]">{hero.eyebrow}</p>
        <h1 class="mt-4 max-w-[12ch] text-white">{hero.h1}</h1>
        <p class="mt-6 max-w-[520px] text-base leading-8 text-white/76">{hero.tagline}</p>
        <a href="#contact" class="btn-light mt-8">立即获取解决方案 <span aria-hidden="true">→</span></a>
      </div>
      <div class="relative min-h-[360px] overflow-hidden rounded-[22px] border border-white/18 shadow-[0_30px_70px_rgba(0,0,0,.28)]">
        <img src="/img/svc-data.webp" alt="明亮整洁的数据基础设施场景，象征搜索优化的技术基础" width={1792} height={1200} loading="eager" class="img-tuned absolute inset-0 h-full w-full object-cover opacity-75" />
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/35 to-transparent"></div>
        <div class="relative flex min-h-[360px] flex-col justify-end p-7 md:p-9"><p class="text-[10px] font-bold uppercase tracking-[.16em] text-[#8fe0e2]">Search foundation</p><h2 class="mt-3 max-w-[12ch] text-2xl text-white">让站点结构、内容与权重协同增长</h2><p class="mt-3 max-w-[460px] text-sm leading-7 text-white/68">技术底座决定收录效率，内容策略承接搜索意图，数据复盘推动排名持续提升。</p></div>
      </div>
    </div>
  </section>

  <Section eyebrow="Why Google SEO" title={sellingPoints.heading} intro="从全球搜索覆盖、品牌沉淀、获客成本和长期流量四个维度，建立可持续的自然获客入口。" centered>
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {sellingPoints.items.map((item, i) => <li class="card-lift rounded-[17px] border border-hairline bg-white p-6 text-left"><span class="flex h-12 w-12 items-center justify-center rounded-[10px] bg-tint text-brand"><Icon name={heroIcons[i]} size={24} /></span><h3 class="mt-6 text-lg">{item.name}</h3><p class="mt-3 text-sm leading-7 text-muted">{item.desc}</p></li>)}
    </ul>
  </Section>

  <Section eyebrow="SEO solutions" title={solution.heading} intro={solution.intro} centered>
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {solution.items.map((item, i) => <li class="card-lift rounded-[17px] border border-hairline p-6"><span class="flex h-12 w-12 items-center justify-center rounded-[9px] bg-brand text-white"><Icon name={solutionIcons[i]} size={25} /></span><h3 class="mt-6">{item.name}</h3>{item.list && <ul class="mt-5 grid grid-cols-2 gap-x-3 gap-y-2 lg:grid-cols-1 xl:grid-cols-2">{item.list.map((text) => <li class="flex gap-2 text-xs leading-5 text-muted"><span class="mt-2 h-1 w-1 shrink-0 bg-brand"></span>{text}</li>)}</ul>}</li>)}
    </ul>
  </Section>

  <Section eyebrow="Reporting" title={reporting.heading} intro={reporting.intro} tone="mint" centered>
    <ol class="grid gap-5 md:grid-cols-3">
      {reporting.items.map((item, i) => <li class="rounded-[17px] border border-white/70 bg-white p-6 text-left shadow-[0_12px_26px_rgba(9,36,72,.055)]"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand font-mono text-xs font-bold text-white">{String(i + 1).padStart(2, '0')}</span><h3 class="mt-5 text-lg">{item.name}</h3><p class="mt-3 text-sm leading-7 text-muted">{item.desc}</p></li>)}
    </ol>
    <div class="mt-10 grid gap-3 md:grid-cols-3">{metrics.map((item) => <div class="rounded-[14px] bg-white px-6 py-9 text-center shadow-[0_10px_24px_rgba(9,36,72,.045)]"><strong class="text-4xl tracking-[-.04em] text-brand">{item[0]}</strong><p class="mt-2 text-sm text-muted">{item[1]}</p></div>)}</div>
    <p class="mt-4 text-center text-xs text-muted">* 参考版式中的演示指标，不代表真实业绩或效果承诺。</p>
  </Section>

  <Section eyebrow="Our process" title={process.heading} intro={process.intro} tone="mint" centered>
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {process.items.map((item, i) => <li class="card-lift rounded-[17px] border border-white/60 bg-white p-6 shadow-[0_12px_24px_rgba(9,36,72,.06)]"><span class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-brand text-brand"><Icon name={processIcons[i]} size={23} /></span><p class="mt-5 font-mono text-[11px] font-bold tracking-[.16em] text-brand/55">STEP {String(i + 1).padStart(2, '0')}</p><h3 class="mt-2">{item.name}</h3><p class="mt-3 text-sm leading-7 text-muted">{item.desc}</p>{item.list && <ul class="mt-4 space-y-2">{item.list.map((text) => <li class="flex gap-2 text-xs text-muted"><span class="text-brand">›</span>{text}</li>)}</ul>}</li>)}
    </ul>
  </Section>

  <Section eyebrow="Success cases" title="SEO 优化 · 成功案例" intro="通过系统化优化，让品牌持续获得更高质量的自然流量。以下均为虚构演示案例。" tone="cloud" centered>
    <ul class="grid gap-5 md:grid-cols-3">{cases.map((item, i) => <li class="card-lift overflow-hidden rounded-[18px] border border-hairline bg-white text-left"><div class="relative"><img src={item.data.image} alt={`${item.data.industry}SEO 案例演示图`} width={1616} height={1008} loading="lazy" class="img-tuned aspect-[8/5] w-full object-cover" /><span class="absolute bottom-3 left-4 text-3xl font-bold text-white">0{i + 1}</span></div><div class="p-6"><p class="text-xs font-bold text-brand">{item.data.industry} · 演示数据</p><h3 class="mt-2">{item.data.company}</h3><p class="mt-3 text-sm leading-7 text-muted">{item.data.result}</p><a href="/cases" class="mt-5 inline-flex text-sm font-bold text-brand">查看详情 →</a></div></li>)}</ul>
  </Section>

  <CTABand title={cta.title} desc={cta.desc} buttonLabel="获取 SEO 诊断" href="#contact" />
  <ContactPanel />
</BaseLayout>
