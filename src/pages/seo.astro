---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';

const entry = await getEntry('pages', 'seo');
if (!entry || entry.data.page !== 'seo') {
  throw new Error('缺少 seo 页面内容');
}
const data = entry.data;
const { hero, sellingPoints, solution, reporting, process, casesNote, cta } = data;

const sellingPointsIcons = ['globe', 'social', 'data', 'search'];
const solutionIcons = ['speed', 'content', 'link', 'data'];
const reportingIcons = ['data', 'monitor', 'flow'];
const processIcons = ['search', 'speed', 'content', 'link', 'monitor', 'flow'];
---

<BaseLayout title={data.title} description={data.description}>
  <Hero
    crumb="Google SEO"
    eyebrow={hero.eyebrow}
    h1={hero.h1}
    tagline={hero.tagline}
    primary={{ label: '获取 SEO 诊断', href: 'mailto:demo@example.com' }}
    secondary={{ label: '看案例', href: '/cases' }}
  >
    <ul slot="right" class="grid grid-cols-2 gap-4">
      {
        sellingPoints.items.map((item, i) => (
          <li class="rounded-[18px] border border-white/25 bg-white/10 p-5 backdrop-blur">
            <span class="flex h-14 w-14 items-center justify-center rounded-[12px] bg-white text-brand">
              <Icon name={sellingPointsIcons[i]} size={28} />
            </span>
            <h3 class="mt-4 text-white">{item.name}</h3>
          </li>
        ))
      }
    </ul>
  </Hero>

  <Section title={sellingPoints.heading} alt>
    <FeatureGrid items={sellingPoints.items} columns={2} icons={sellingPointsIcons} />
  </Section>

  <Section title={solution.heading} intro={solution.intro}>
    <FeatureGrid items={solution.items} columns={2} icons={solutionIcons} />
  </Section>

  <Section title={reporting.heading} intro={reporting.intro} tone="mint">
    <FeatureGrid items={reporting.items} columns={3} numbered icons={reportingIcons} />
  </Section>

  <Section title={process.heading} intro={process.intro} tone="mint">
    <FeatureGrid items={process.items} columns={3} numbered icons={processIcons} />
  </Section>

  <Section title={casesNote.heading}>
    <p class="max-w-[720px] text-muted">{casesNote.text}</p>
    <a href={casesNote.href} class="btn-accent mt-8">
      {casesNote.linkLabel}
      <span aria-hidden="true">→</span>
    </a>
  </Section>

  <CTABand title={cta.title} desc={cta.desc} buttonLabel={cta.buttonLabel} href={cta.href} />
</BaseLayout>
