---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SpecTable from '../components/SpecTable.astro';
import CTABand from '../components/CTABand.astro';

const entry = await getEntry('pages', 'website');
if (!entry || entry.data.page !== 'website') {
  throw new Error('缺少 website 页面内容');
}
const data = entry.data;
const { hero, whyUs, plans, customValue, serviceGroups, featureModules, guarantee, ops, cta } =
  data;

const whyUsIcons = ['structure', 'support', 'flow', 'speed', 'delivery', 'data'];
const customValueIcons = ['structure', 'monitor', 'flow', 'search', 'security', 'social'];
---

<BaseLayout title={data.title} description={data.description}>
  <Hero
    crumb="网站建设"
    h1={hero.h1}
    tagline={hero.tagline}
    primary={{ label: '获取建站方案', href: 'mailto:demo@example.com' }}
    secondary={{ label: '看案例', href: '/cases' }}
    image={{
      src: '/img/hero-website.webp',
      alt: '工作台上的笔记本电脑显示无文字企业站线框，旁边是工业样品与纸箱',
      width: 2400,
      height: 1056,
    }}
  />

  <Section title={whyUs.heading} intro={whyUs.intro} alt>
    <FeatureGrid items={whyUs.items} columns={3} icons={whyUsIcons} />
  </Section>

  <Section title={plans.heading} intro={plans.intro}>
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <div class="grid gap-4 md:gap-6">
        {
          plans.items.map((plan, i) => (
            <article class="rounded-[18px] border border-hairline bg-white p-7">
              <span
                aria-hidden="true"
                class={`mb-5 flex h-14 w-14 items-center justify-center rounded-[12px] text-lg font-bold ${
                  i === 0 ? 'bg-tint text-brand' : 'bg-primary text-white'
                }`}
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="text-[13px] font-semibold tracking-[.08em] text-accent">{plan.eyebrow}</p>
              <h3 class="mt-2">{plan.name}</h3>
              <p class="mt-2 text-[15px] text-muted">{plan.desc}</p>
              <ul class="mt-6 space-y-4">
                {plan.points.map((pt) => (
                  <li class="text-sm text-muted">
                    <strong class="mr-2 font-semibold text-primary">{pt.name}</strong>
                    {pt.desc}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <figure class="overflow-hidden rounded-[18px] border border-hairline">
        <img
          src="/img/svc-design.webp"
          alt="俯拍的设计工作台，桌上摆着网站线框草图与色卡"
          width={1792}
          height={1200}
          loading="lazy"
          class="img-tuned aspect-[3/2] w-full object-cover"
        />
      </figure>
    </div>
  </Section>

  <Section title={customValue.heading} intro={customValue.intro} alt>
    <FeatureGrid items={customValue.items} columns={3} numbered icons={customValueIcons} />
  </Section>

  <Section title={serviceGroups.heading} intro={serviceGroups.intro}>
    <figure class="mb-10 overflow-hidden rounded-[18px] border border-hairline">
      <img
        src="/img/mid-workshop.webp"
        alt="机加工工作台特写，黄铜零件与金属屑"
        width={1792}
        height={1200}
        loading="lazy"
        class="img-tuned aspect-[21/9] w-full object-cover"
      />
    </figure>
    <div class="space-y-10">
      {
        serviceGroups.groups.map((group) => (
          <div>
            <h3>{group.name}</h3>
            {group.intro && <p class="mt-2 max-w-[720px] text-sm text-muted">{group.intro}</p>}
            <div class="mt-4">
              <SpecTable
                columns={serviceGroups.columns}
                rows={group.rows}
                checkCells
                leftCols={2}
              />
            </div>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">{serviceGroups.note}</p>
  </Section>

  <Section title={featureModules.heading} intro={featureModules.intro} alt>
    <figure class="mb-10 overflow-hidden rounded-[18px] border border-hairline">
      <img
        src="/img/mid-responsive.webp"
        alt="手机与屏幕设备显示同一套无文字线框"
        width={1792}
        height={1200}
        loading="lazy"
        class="img-tuned aspect-[21/9] w-full object-cover"
      />
    </figure>
    <SpecTable
      columns={featureModules.columns}
      rows={featureModules.rows}
      limit={12}
      wide
      rowHeaders={false}
      leftCols={2}
    />
  </Section>

  <Section title={guarantee.heading}>
    <figure class="mb-10 overflow-hidden rounded-[18px] border border-hairline">
      <img
        src="/img/mid-office.webp"
        alt="空会议室，白板上只有矩形与箭头草图"
        width={1792}
        height={1200}
        loading="lazy"
        class="img-tuned aspect-[21/9] w-full object-cover"
      />
    </figure>
    <div class="grid gap-4 md:grid-cols-2 md:gap-6">
      {
        guarantee.items.map((item) => (
          <article class="rounded-[18px] border border-hairline bg-white p-7">
            <h3>{item.name}</h3>
            <ul class="mt-4 space-y-2">
              {item.points.map((point) => (
                <li class="flex gap-2 text-[15px] text-muted">
                  <span aria-hidden="true" class="text-brand">·</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <Section title={ops.heading} alt>
    <div class="grid gap-12 md:grid-cols-2 md:items-center">
      <figure class="order-1 overflow-hidden rounded-[18px] border border-hairline md:order-2">
        <img
          src="/img/svc-data.webp"
          alt="机房走道，两侧是成排的服务器机柜"
          width={1792}
          height={1200}
          loading="lazy"
          class="img-tuned aspect-[3/2] w-full object-cover"
        />
      </figure>
      <div class="order-2 max-w-[720px] space-y-4 md:order-1">
        {ops.body.map((paragraph) => <p class="text-muted">{paragraph}</p>)}
      </div>
    </div>
  </Section>

  <div class="mx-auto max-w-[1200px] px-4 md:px-6">
    <figure class="overflow-hidden rounded-[18px] border border-hairline">
      <img
        src="/img/mid-warehouse.webp"
        alt="出口仓库内托盘上的无印刷纸箱与货架"
        width={1792}
        height={1200}
        loading="lazy"
        class="img-tuned aspect-[21/9] w-full object-cover"
      />
    </figure>
  </div>

  <div class="h-14 md:h-24" aria-hidden="true"></div>

  <CTABand title={cta.title} desc={cta.desc} buttonLabel={cta.buttonLabel} href={cta.href} />
</BaseLayout>
