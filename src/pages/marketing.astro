---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SpecTable from '../components/SpecTable.astro';
import CTABand from '../components/CTABand.astro';

const entry = await getEntry('pages', 'marketing');
if (!entry || entry.data.page !== 'marketing') {
  throw new Error('缺少 marketing 页面内容');
}
const data = entry.data;
const { hero, plans, delivery, inquiryStandard, eightElements, responsibilities, cta } = data;

const eightElementsIcons = [
  'structure',
  'support',
  'search',
  'data',
  'content',
  'social',
  'delivery',
  'monitor',
];
---

<BaseLayout title={data.title} description={data.description}>
  <Hero
    crumb="全网营销"
    h1={hero.h1}
    tagline={hero.tagline}
    primary={{ label: '获取推广方案', href: 'mailto:demo@example.com' }}
    secondary={{ label: '看案例', href: '/cases' }}
  />

  <Section title={plans.heading} intro={plans.intro} alt>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {
        plans.items.map((plan) => (
          <article class="card-hover rounded-[18px] border border-hairline bg-white p-7">
            {plan.tag && (
              <p class="mb-4 inline-block rounded-full border border-accent px-3 py-1 text-xs font-semibold text-accent">
                {plan.tag}
              </p>
            )}
            <h3>{plan.name}</h3>
            <p class="mt-4 text-[46px] font-bold leading-none tabular-nums text-brand">
              {plan.countries.replace(' 个国家', '')}
            </p>
            <p class="mt-2 text-sm text-muted">覆盖国家 · 服务周期 {plan.period}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section title={delivery.heading} intro={delivery.intro}>
    <div class="space-y-10">
      {
        delivery.tables.map((table) => (
          <div>
            {table.heading && <h3>{table.heading}</h3>}
            {table.intro && <p class="mt-2 max-w-[720px] text-sm text-muted">{table.intro}</p>}
            <div class="mt-4">
              <SpecTable
                columns={table.columns}
                rows={table.rows}
                wide={table.wide}
                note={table.note}
                checkCells
              />
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title={inquiryStandard.heading} intro={inquiryStandard.intro} alt>
    <div class="grid gap-4 md:grid-cols-2 md:gap-6">
      {
        inquiryStandard.regions.map((region) => (
          <article class="rounded-[18px] border border-hairline bg-white p-7">
            <h3>
              {region.name}
              <span class="ml-2 text-sm font-normal tabular-nums text-muted">
                {region.countries.length} 个国家 / 地区
              </span>
            </h3>
            <p class="mt-4 flex flex-wrap gap-2 text-sm">
              {region.countries.map((country) => (
                <span class="rounded-full bg-tint px-3 py-1 text-primary">{country}</span>
              ))}
            </p>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">{inquiryStandard.note}</p>
  </Section>

  <Section title={eightElements.heading} intro={eightElements.intro}>
    <FeatureGrid items={eightElements.items} columns={4} numbered icons={eightElementsIcons} />
    {
      eightElements.note && (
        <p class="mt-6 max-w-[720px] text-sm text-muted">{eightElements.note}</p>
      )
    }
    {
      eightElements.notes && (
        <ul class="mt-6 max-w-[720px] space-y-2">
          {eightElements.notes.map((note) => (
            <li class="text-sm text-muted">{note}</li>
          ))}
        </ul>
      )
    }
  </Section>

  <Section title={responsibilities.heading} intro={responsibilities.intro} alt>
    <SpecTable
      columns={responsibilities.columns}
      rows={responsibilities.rows}
      note={responsibilities.note}
      rowHeaders={false}
    />
  </Section>

  <CTABand title={cta.title} desc={cta.desc} buttonLabel={cta.buttonLabel} href={cta.href} />
</BaseLayout>
