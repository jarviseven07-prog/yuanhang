---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SpecTable from '../components/SpecTable.astro';
import CTABand from '../components/CTABand.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/paths';

const entry = await getEntry('pages', 'marketing');
if (!entry || entry.data.page !== 'marketing') throw new Error('缺少 marketing 页面内容');
const data = entry.data;
const { hero, plans, delivery, inquiryStandard, eightElements, responsibilities, cta } = data;
const prices = ['6.98', '9.98', '13.98', '19.8'];
const tableIcons = ['data', 'link', 'social', 'flow', 'support'];
const inquiryIcons = ['building', 'person', 'target', 'wallet', 'handshake', 'message', 'mail', 'brand'];
const marketingNav = [
  ['delivery-1', '效果 KPI'],
  ['delivery-2', '账号矩阵'],
  ['delivery-3', '运营交付'],
  ['delivery-4', '营销系统'],
  ['delivery-5', '客资系统'],
  ['inquiry-standard', '询盘标准'],
  ['eight-elements', '8 要素询盘'],
  ['provider', '我们提供'],
  ['client', '客户配合'],
];
---

<BaseLayout title={data.title} description={data.description}>
  <section class="hero-gradient relative min-h-[410px] overflow-hidden pb-24 text-white md:pb-32">
    <div class="hero-grid"></div><div class="hero-glow"></div>
    <div class="container-shell relative pt-8 md:pt-11">
      <nav aria-label="面包屑" class="text-xs text-white/60"><a href={withBase('/website')} class="hover:text-white">首页</a><span class="mx-2">/</span>全网营销</nav>
      <div class="mx-auto mt-12 max-w-[820px] text-center">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-white/60">Social growth suite</p>
        <h1 class="mt-4 text-white">{hero.h1}<br /><span class="text-[#86dbea]">保障交付，聚焦有效询盘</span></h1>
        <p class="mx-auto mt-6 max-w-[680px] text-sm leading-7 text-white/72 md:text-base">{hero.tagline}</p>
      </div>
    </div>
  </section>

  <section class="relative z-10 -mt-20 pb-16 md:-mt-24 md:pb-24">
    <div class="container-shell grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {plans.items.map((plan, i) => (
        <article class={`card-lift relative rounded-[17px] border bg-white p-6 shadow-[0_18px_44px_rgba(9,36,72,.12)] ${i === 0 ? 'border-brand' : 'border-hairline'}`}>
          {plan.tag && <span class="absolute -top-3 left-5 rounded-full bg-brand px-3 py-1 text-[10px] font-bold text-white">推荐方案</span>}
          <p class="text-sm font-bold text-primary">{plan.name}</p>
          <p class="mt-5 flex items-end gap-1 text-brand"><span class="pb-1 text-sm font-bold">¥</span><strong class="text-[44px] leading-none tracking-[-.05em]">{prices[i]}</strong><span class="pb-1 text-sm font-bold">万</span></p>
          <p class="mt-3 text-xs text-muted">{plan.countries} · {plan.period}</p>
        </article>
      ))}
    </div>
    <p class="container-shell mt-5 text-center text-xs text-muted">以上价格与档位为参考站版式演示数据，实际合作以正式合同为准。</p>
  </section>

  <section class="bg-cloud py-20 md:py-28">
    <div class="container-shell grid gap-8 lg:grid-cols-[minmax(0,1fr)_220px]">
      <div class="min-w-0 space-y-20 md:space-y-24">
        <div class="mb-8"><p class="eyebrow">Delivery matrix</p><h2 class="mt-3">{delivery.heading}</h2><p class="mt-4 max-w-[760px] text-muted">{delivery.intro}</p><p class="mt-3 text-xs text-muted">价格、数量与效果指标均为参考版式 Demo 数据，实际交付以正式合同为准。</p></div>
        <div class="space-y-10">
          {delivery.tables.map((table, i) => (
            <article id={`delivery-${i + 1}`} class="min-w-0 scroll-mt-24 rounded-[18px] border border-hairline bg-white p-3 shadow-[0_14px_34px_rgba(9,36,72,.055)] md:p-5">
              <div class="flex items-center gap-4 px-2 py-3"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-tint text-brand"><Icon name={tableIcons[i] ?? 'structure'} size={22} /></span><div>{table.heading && <h3>{table.heading}</h3>}{table.intro && <p class="mt-1 text-xs text-muted">{table.intro}</p>}</div></div>
              <div class="mt-2"><SpecTable columns={table.columns} rows={table.rows} wide={table.wide} note={table.note} checkCells /></div>
            </article>
          ))}
        </div>

        <section id="inquiry-standard" class="scroll-mt-24">
          <div class="text-center"><p class="eyebrow">Lead standard</p><h2 class="mt-3">{inquiryStandard.heading}</h2><p class="mx-auto mt-4 max-w-[760px] text-muted">{inquiryStandard.intro}</p></div>
          <div class="mt-10 grid gap-4 md:grid-cols-2">
            {inquiryStandard.regions.map((region, i) => <article class="rounded-[16px] border border-hairline bg-white p-6"><div class="flex items-center justify-between gap-4"><h3>{region.name}</h3><span class="font-mono text-xs font-bold text-brand">0{i + 1}</span></div><p class="mt-5 flex flex-wrap gap-2">{region.countries.map((country) => <span class="rounded-full bg-tint px-3 py-1 text-xs text-primary">{country}</span>)}</p></article>)}
          </div>
          <p class="mt-5 text-xs text-muted">{inquiryStandard.note}</p>
          <article class="mt-10 rounded-[18px] border border-hairline bg-white p-3 text-left shadow-[0_14px_34px_rgba(9,36,72,.055)] md:p-5">
            <div class="flex items-center gap-4 px-2 py-3"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-tint text-brand"><Icon name="delivery" size={22} /></span><div><h3>{inquiryStandard.quotaTable.heading}</h3><p class="mt-1 text-xs text-muted">同一区域前三档按半年度口径，旗舰版按年度口径。</p></div></div>
            <div class="mt-2"><SpecTable columns={inquiryStandard.quotaTable.columns} rows={inquiryStandard.quotaTable.rows} wide checkCells /></div>
          </article>
        </section>

        <section id="eight-elements" class="scroll-mt-24 overflow-hidden rounded-[20px] border border-hairline bg-white shadow-[0_14px_34px_rgba(9,36,72,.055)]">
          <div class="flex items-start gap-4 border-b border-hairline px-6 py-6 md:px-8"><span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[12px] bg-mint text-[#18a978]"><Icon name="check" size={27} /></span><div><p class="eyebrow">Qualified inquiry</p><h2 class="mt-2">{eightElements.heading}</h2><p class="mt-2 max-w-[800px] text-sm leading-7 text-muted">{eightElements.intro}</p></div></div>
          <ul class="grid gap-4 p-6 sm:grid-cols-2 md:p-8 xl:grid-cols-4">
            {eightElements.items.map((item, i) => <li class="card-lift relative rounded-[15px] border border-hairline bg-[#f8fbff] p-5"><span class="flex h-12 w-12 items-center justify-center rounded-[12px] bg-tint text-brand"><Icon name={inquiryIcons[i]} size={25} /></span><span class="absolute right-5 top-5 font-mono text-[10px] font-bold tracking-[.12em] text-brand/45">{String(i + 1).padStart(2, '0')}</span><h3 class="mt-5 text-base">{item.name}</h3><p class="mt-2 text-xs leading-6 text-muted">{item.desc}</p></li>)}
          </ul>
          {eightElements.note && <p class="mx-auto max-w-[840px] px-6 pb-6 text-center font-semibold text-brand">{eightElements.note}</p>}
          {eightElements.notes && <div class="mx-6 mb-6 rounded-[14px] border border-hairline bg-cloud p-5 text-left md:mx-8 md:mb-8">{eightElements.notes.map((note) => <p class="py-1 text-xs leading-6 text-muted">{note}</p>)}</div>}
        </section>

        <section class="grid overflow-hidden rounded-[20px] bg-primary text-white lg:grid-cols-[.9fr_1.1fr]">
          <div class="flex flex-col justify-center p-8 lg:p-10"><p class="text-xs font-bold uppercase tracking-[.16em] text-[#8fe0e2]">Content to inquiry</p><h2 class="mt-4 text-white">从工厂素材到精准询盘闭环</h2><p class="mt-5 text-sm leading-7 text-white/70">围绕真实产线、产品细节与应用场景建立素材库，再通过多平台剪辑、发布、投放和统一客资承接，让内容生产与销售跟进连接起来。</p><div class="mt-7 grid grid-cols-3 gap-3">{[['01','素材采集'],['02','矩阵分发'],['03','线索承接']].map((item) => <div class="border-t border-white/20 pt-3"><strong class="block text-lg text-[#8fe0e2]">{item[0]}</strong><span class="mt-1 block text-xs text-white/58">{item[1]}</span></div>)}</div></div>
          <div class="relative min-h-[320px]"><img src={withBase('/img/mid-workshop.webp')} alt="整洁工厂中的成批产品与社媒内容素材场景" width={1792} height={1200} loading="eager" class="img-tuned absolute inset-0 h-full w-full object-cover" /><div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/20 to-transparent"></div></div>
        </section>

        <div class="space-y-10">
          {responsibilities.columns.map((column, ci) => (
            <section id={ci === 0 ? 'provider' : 'client'} class="scroll-mt-24 overflow-hidden rounded-[18px] border border-hairline bg-white shadow-[0_14px_34px_rgba(9,36,72,.055)]">
              <div class={`flex items-center gap-4 px-6 py-5 ${ci === 0 ? 'bg-tint text-brand' : 'bg-mint text-[#126a85]'}`}><span class="flex h-10 w-10 items-center justify-center rounded-[10px] bg-white"><Icon name={ci === 0 ? 'support' : 'check'} size={21} /></span><div><p class="text-[10px] font-bold uppercase tracking-[.14em] opacity-65">Responsibilities 0{ci + 1}</p><h2 class="mt-1 text-xl text-current">{column}</h2></div></div>
              <ol class="divide-y divide-hairline px-6">{responsibilities.rows.filter((row) => row[ci] !== '—').map((row, i) => <li class="flex gap-4 py-5 text-sm leading-7 text-muted"><span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold ${ci === 0 ? 'bg-tint text-brand' : 'bg-mint text-[#126a85]'}`}>{i + 1}</span><span>{row[ci]}</span></li>)}</ol>
            </section>
          ))}
          <p class="text-xs text-muted">{responsibilities.note}</p>
        </div>
      </div>
      <aside class="hidden lg:block"><nav aria-label="本页目录" class="sticky top-24 rounded-[16px] border border-hairline bg-white p-5 shadow-[0_12px_28px_rgba(9,36,72,.055)]"><p class="border-b border-hairline pb-4 text-sm font-bold text-primary">目录导航</p><ul class="mt-3 space-y-1 text-sm">{marketingNav.map((item) => <li><a class="block rounded-[8px] px-3 py-2 text-muted transition hover:bg-tint hover:text-brand" href={`#${item[0]}`}>{item[1]}</a></li>)}</ul></nav></aside>
    </div>
  </section>

  <CTABand title={cta.title} desc={cta.desc} buttonLabel="查看方案详情" href="#contact" />
  <ContactPanel />
</BaseLayout>
