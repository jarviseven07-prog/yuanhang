---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.id.localeCompare(b.id));

const title = '成功案例 - 远航';
const description =
  '远航成功案例页：六个虚构行业的演示案例，展示网站建设、全网营销、Google SEO 与 GEO 优化的组合方向。本页为演示数据。';
---

<BaseLayout title={title} description={description}>
  <section class="bg-primary">
    <div class="mx-auto max-w-[1200px] px-4 py-12 md:px-6 md:py-20">
      <h1 class="text-white">成功案例</h1>
      <p class="mt-4 max-w-[720px] text-slate-200 md:text-lg">
        六个虚构行业的演示案例，展示不同服务模块的组合方向。
      </p>
      <p class="mt-6 inline-block rounded border border-slate-300 px-4 py-2 text-sm text-white">
        以下为演示数据，非真实客户案例。
      </p>
    </div>
  </section>

  <Section>
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
      {
        cases.map((item) => (
          <li class="overflow-hidden rounded border border-slate-200 bg-white">
            <div
              class="flex h-40 items-center justify-center"
              style={`background-color: ${item.data.color};`}
            >
              <span class="text-4xl font-bold text-white" aria-hidden="true">
                {item.data.company.charAt(0)}
              </span>
            </div>
            <div class="p-6">
              <p class="text-sm text-slate-500">{item.data.industry}</p>
              <h3 class="mt-2">
                {item.data.company}
                <span class="ml-2 text-sm font-normal text-slate-500">{item.data.companyEn}</span>
              </h3>
              <p class="mt-4 flex flex-wrap gap-2">
                {item.data.tags.map((tag) => (
                  <span class="rounded border border-slate-200 bg-slate-50 px-2 py-1 text-xs text-slate-700">
                    {tag}
                  </span>
                ))}
              </p>
              <p class="mt-4 text-sm text-slate-700">{item.data.result}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
