---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.id.localeCompare(b.id));
const industryIcon: Record<string, string> = { 工业阀门: 'valve', 户外家具: 'furniture', 汽车配件: 'gear', 建材: 'stack', 医疗器械: 'pulse', 消费电子: 'chip' };
const title = '成功案例 - 远航跨境';
const description = '远航跨境成功案例页：六个虚构行业的演示案例，展示网站建设、全网营销、Google SEO 与 GEO 优化的组合方向。';
---

<BaseLayout title={title} description={description}>
  <Hero crumb="成功案例" h1="多样化的选择" tagline="从电子、制造到消费与建材，以真实业务场景为原型，展示独立站和增长服务的组合方式。" note="以下公司与结果均为演示数据，非真实客户案例。" image={{ src: '/img/hero-website.webp', alt: '现代工作台上的企业网站设计界面', width: 2400, height: 1056 }} />

  <section class="bg-cloud py-16 md:py-24">
    <div class="container-shell">
      <p class="eyebrow">Selected work</p>
      <h2 class="mt-3">标杆案例</h2>
      <p class="mt-4 max-w-[720px] text-muted">远航跨境为六个虚构行业品牌设计的独立站与数字增长 Demo。点击卡片可查看服务组合方向，页面中的品牌与成效均为演示数据。</p>
      <div class="mt-7 inline-flex rounded-full border border-hairline bg-white p-1 text-sm"><span class="rounded-full bg-brand px-5 py-2 font-bold text-white">标杆案例</span><span class="px-5 py-2 text-muted">常规定制</span></div>

      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {cases.map((item, i) => (
          <li class="card-lift group overflow-hidden rounded-[18px] border border-hairline bg-white shadow-[0_12px_30px_rgba(9,36,72,.055)]">
            <div class="relative overflow-hidden"><img src={item.data.image} alt={`${item.data.industry}行业场景演示图`} width={1616} height={1008} loading={i < 3 ? 'eager' : 'lazy'} class="img-tuned aspect-[8/5] w-full object-cover transition duration-500 group-hover:scale-[1.025]" /><span class="absolute bottom-3 left-4 text-3xl font-bold text-white">{String(i + 1).padStart(2, '0')}</span></div>
            <div class="p-6">
              <p class="flex items-center gap-2 text-xs font-bold text-brand">{industryIcon[item.data.industry] && <Icon name={industryIcon[item.data.industry]} size={15} />}{item.data.industry} · 演示数据</p>
              <h3 class="mt-3 text-xl">{item.data.company}（{item.data.companyEn}）外贸独立站案例</h3>
              <p class="mt-3 line-clamp-3 text-sm leading-7 text-muted">{item.data.result}</p>
              <p class="mt-5 flex flex-wrap gap-2">{item.data.tags.map((tag) => <span class="rounded-full bg-tint px-3 py-1 text-[11px] font-semibold text-primary">{tag}</span>)}</p>
              <a href="mailto:demo@example.com" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand">查看案例 <span aria-hidden="true">→</span></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
