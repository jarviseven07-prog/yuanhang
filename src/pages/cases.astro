---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.id.localeCompare(b.id));

const industryIcon: Record<string, string> = {
  工业阀门: 'valve',
  户外家具: 'furniture',
  汽车配件: 'gear',
  建材: 'stack',
  医疗器械: 'pulse',
  消费电子: 'chip',
};

const title = '成功案例 - 远航';
const description =
  '远航成功案例页：六个虚构行业的演示案例，展示网站建设、全网营销、Google SEO 与 GEO 优化的组合方向。本页为演示数据。';
---

<BaseLayout title={title} description={description}>
  <Hero
    crumb="成功案例"
    h1="成功案例"
    tagline="六个虚构行业的演示案例，展示不同服务模块的组合方向。"
    note="以下为演示数据，非真实客户案例。"
  />

  <Section>
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
      {
        cases.map((item) => (
          <li class="card-hover overflow-hidden rounded-[18px] border border-hairline bg-white">
            <img
              src={item.data.image}
              alt={`${item.data.industry}行业场景演示图`}
              width={1616}
              height={1008}
              loading="lazy"
              class="img-tuned aspect-[8/5] w-full object-cover"
            />
            <div class="p-6">
              <p class="flex items-center gap-1.5 text-[12px] tracking-[.08em] text-muted">
                {industryIcon[item.data.industry] && (
                  <Icon name={industryIcon[item.data.industry]} size={14} class="text-brand" />
                )}
                {item.data.industry}
              </p>
              <h3 class="mt-2">{item.data.company}</h3>
              <p class="text-[13px] font-medium text-muted">{item.data.companyEn}</p>
              <p class="mt-4 flex flex-wrap gap-2">
                {item.data.tags.map((tag) => (
                  <span class="rounded-full border border-brand px-3 py-1 text-xs font-medium text-brand">
                    {tag}
                  </span>
                ))}
              </p>
              <p class="mt-4 text-[15px] leading-[1.65] text-ink">{item.data.result}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
