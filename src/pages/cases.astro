---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import ContactPanel from '../components/ContactPanel.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.id.localeCompare(b.id));
const industryIcon: Record<string, string> = { 工业阀门: 'valve', 户外家具: 'furniture', 汽车配件: 'gear', 建材: 'stack', 医疗器械: 'pulse', 消费电子: 'chip' };
const steps = [
  { icon: 'structure', title: '建站打底', desc: '以转化为导向搭建独立站，把架构、性能与结构化数据一次做对，承接后续所有流量。', href: '/website', label: '网站建设' },
  { icon: 'search', title: '搜索获客', desc: 'Google SEO 让有采购意向的买家在主动搜索时找到你，形成稳定的自然流量。', href: '/seo', label: 'Google SEO' },
  { icon: 'social', title: '社媒扩量', desc: '围绕目标国家搭建社媒矩阵，用内容持续触达买家，并把咨询统一承接成询盘。', href: '/marketing', label: '全网营销' },
  { icon: 'ai', title: 'AI 占位', desc: 'GEO 让品牌出现在 ChatGPT 等 AI 回答里，提前锁定新一代搜索入口。', href: '/geo', label: 'GEO 优化' },
];
const title = '成功案例 - 远航';
const description = '远航成功案例页：六个虚构行业的演示案例，展示网站建设、全网营销、Google SEO 与 GEO 优化的组合方向。';
---

<BaseLayout title={title} description={description}>
  <Hero crumb="成功案例" h1="多样化的选择" tagline="从电子、制造到消费与建材，以真实业务场景为原型，展示独立站和增长服务的组合方式。" note="以下公司与结果均为演示数据，非真实客户案例。">
    <ul slot="right" class="grid grid-cols-3 gap-2 sm:gap-3" aria-label="六个行业案例图片拼贴">
      {cases.map((item, i) => (
        <li class="group relative overflow-hidden rounded-[12px] border border-white/15">
          <img src={item.data.image} alt={`${item.data.industry}行业案例演示图`} width={1616} height={1008} loading={i < 3 ? 'eager' : 'lazy'} class="img-tuned aspect-[8/5] h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" />
          <span class="absolute left-2 top-2 rounded-full bg-white/92 px-2 py-0.5 text-[10px] font-bold tracking-[.08em] text-brand">{String(i + 1).padStart(2, '0')}</span>
        </li>
      ))}
    </ul>
  </Hero>

  <Section eyebrow="Industry coverage" title="六个行业，一套增长组合" intro="六家虚构企业覆盖外贸最常见的行业类型。行业不同，起点都是「建站 + 增长服务」的组合。" centered>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cases.map((item) => (
        <li class="card-lift flex items-center gap-4 rounded-[16px] border border-hairline bg-white p-5">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-brand text-white"><Icon name={industryIcon[item.data.industry] ?? 'structure'} size={22} /></span>
          <div class="min-w-0">
            <h3 class="text-base">{item.data.industry}</h3>
            <p class="mt-1 truncate text-xs text-muted">{item.data.tags.join(' + ')}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="Selected work" title="标杆案例" intro="远航为六个虚构行业品牌设计的独立站与数字增长 Demo，页面中的品牌与成效均为演示数据。" tone="tint" centered>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {cases.map((item, i) => (
        <li class="card-lift group overflow-hidden rounded-[18px] border border-hairline bg-white shadow-[0_12px_30px_rgba(9,36,72,.055)]">
          <div class="relative overflow-hidden">
            <img src={item.data.image} alt={`${item.data.industry}行业场景演示图`} width={1616} height={1008} loading={i < 3 ? 'eager' : 'lazy'} class="img-tuned aspect-[8/5] w-full object-cover transition duration-500 group-hover:scale-[1.025]" />
            <span class="absolute left-5 top-4 rounded-full bg-white/92 px-3 py-1 text-[11px] font-bold tracking-[.1em] text-brand">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="p-6">
            <p class="flex items-center gap-2 text-xs font-bold text-brand">
              {industryIcon[item.data.industry] && <Icon name={industryIcon[item.data.industry]} size={15} />}
              {item.data.industry} · 演示数据
            </p>
            <h3 class="mt-3 text-xl">{item.data.company}（{item.data.companyEn}）外贸独立站案例</h3>
            <p class="mt-3 line-clamp-3 text-sm leading-7 text-muted">{item.data.result}</p>
            <p class="mt-5 flex flex-wrap gap-2">
              {item.data.tags.map((tag) => <span class="rounded-full bg-tint px-3 py-1 text-[11px] font-semibold text-primary">{tag}</span>)}
            </p>
            <a href="mailto:demo@example.com" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand">查看案例 <span aria-hidden="true">→</span></a>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section eyebrow="How we work" title="案例背后，是同一套服务组合" intro="六个行业的出发点不同，路径都从这四步开始。点击进入对应服务页了解交付细节。" centered>
    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="card-lift flex h-full flex-col rounded-[16px] border border-hairline bg-white p-6">
          <div class="flex items-center justify-between">
            <span class="flex h-11 w-11 items-center justify-center rounded-[10px] bg-brand text-white"><Icon name={step.icon} size={22} /></span>
            <span class="font-mono text-[11px] font-bold tracking-[.14em] text-brand/45">STEP {String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mt-5 text-lg">{step.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-7 text-muted">{step.desc}</p>
          <a href={step.href} class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-brand">{step.label} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ol>
  </Section>

  <CTABand title="把你的行业做成下一个案例" desc="告诉我们你的行业与目标市场，获取建站、SEO、社媒与 GEO 的组合建议。" buttonLabel="获取组合方案" href="#contact" />
  <ContactPanel />
</BaseLayout>
